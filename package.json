{
  "name": "@hythe/mcp",
  "version": "0.1.2",
  "description": "HYTHE — coordination bus + shared truth for AI agent fleets (MCP server + stdio bridge).",
  "mcpName": "dev.hythe/hythe",
  "repository": {
    "type": "git",
    "url": "https://github.com/hythe-dev/hythe.git"
  },
  "homepage": "https://hythe.dev",
  "bugs": {
    "url": "https://github.com/hythe-dev/hythe/issues"
  },
  "type": "module",
  "main": "dist/unified-neural-mcp-server.js",
  "bin": {
    "hythe-mcp": "bin/engram-mcp.cjs"
  },
  "files": [
    "bin/",
    "dist/",
    "mcp-stdio-http-bridge.cjs",
    "docker/",
    "docs/",
    ".env.example",
    "TOOL-COMPATIBILITY-MAP.md",
    "BACKUP-AND-RESTORE.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/unified-neural-mcp-server.js",
    "dev": "tsx src/unified-neural-mcp-server.ts",
    "unified:start": "node dist/unified-neural-mcp-server.js",
    "unified:prod": "NODE_ENV=production node dist/unified-neural-mcp-server.js",
    "mcp:start": "node dist/unified-neural-mcp-server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write src/**/*.ts",
    "docs:tools": "tsx scripts/generate-tool-docs.ts",
    "docs:check": "tsx scripts/check-schema-docs.ts",
    "ci:schemas": "npm run docs:check && tsx scripts/check-servers-use-unified.ts",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -f docker/Dockerfile -t engram .",
    "docker:run": "docker compose -f docker/docker-compose.yml up -d",
    "docker:stop": "docker compose -f docker/docker-compose.yml down",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "postbuild": "echo 'Build completed successfully'"
  },
  "keywords": [
    "mcp",
    "agents",
    "memory",
    "coordination",
    "knowledge-graph"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "ajv": "^6.15.0",
    "@xenova/transformers": "^2.17.2",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^9.2.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "events": "^3.3.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "rate-limiter-flexible": "^5.0.5",
    "redis": "^4.6.12",
    "sqlite": "^5.1.1",
    "sqlite-vec": "^0.1.7-alpha.2",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1",
    "weaviate-ts-client": "^1.4.0",
    "winston": "^3.11.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.8",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitest/coverage-v8": "^1.1.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^7.2.2",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "hytheDistribution": true
}
