# HYTHE configuration — copy to .env and fill in.
# These are the ACTUAL variables the runtime reads (verified by the
# final-tree smoke gate); nothing here is aspirational.

# Shared API key: the server's auth middleware and the stdio bridge both use
# API_KEY. Generate one with the first-run wizard:
#   npx -y @hythe/mcp init --write-env --agent-id <agent-id>
# Legacy compatibility: npx -y @tomcat65/engram-mcp init --write-env --agent-id <agent-id>
# (or manually:  openssl rand -base64 32 )
# The placeholder below is DELIBERATELY too short to pass the startup
# guard — an untouched .env cannot boot (fail-closed by design).
API_KEY=CHANGE_ME

# --- Server ---
# HTTP MCP port (compose maps it to 127.0.0.1:6174 by default).
NEURAL_MCP_PORT=6174
# Authenticated WebSocket notification port (compose maps it separately).
MESSAGE_HUB_PORT=3004
# SQLite database path. Local runs: ./data/engram.db
# (compose overrides this to /app/data/engram.db on the engram_data volume).
NEURAL_DB_PATH=./data/engram.db

# --- Stdio bridge (per MCP client) ---
# The bridge also requires one explicit HYTHE_AGENT_ID in each individual MCP
# client configuration. Do not put a shared or placeholder identity in this
# server-wide file; generate the per-client block with `init --agent-id`.
# It reads API_KEY (same key as above) plus:
MCP_HOST=127.0.0.1
MCP_PORT=6174

# --- Optional hardening ---
# Comma-separated browser origins allowed by CORS. Unset = no cross-origin
# browser access (closed-safe default). Same-origin and non-browser clients
# (the stdio bridge, curl) are unaffected. '*' is an explicit opt-in.
# CORS_ORIGINS=

# --- Optional embedding runtime settings ---
# The npm package has no transformer runtime by default: it uses deterministic
# 384-dimension token-hash vectors and creates no model cache. The Docker image
# supplies an independently locked Xenova runtime and requires its q8 preflight
# before serving. Its default cache is /app/data/models.
# SQLITE_VEC_CACHE_DIR=./data/models
# SQLITE_VEC_MODEL=Xenova/all-MiniLM-L6-v2
# SQLITE_VEC_DIMENSIONS=384
# Set false only when the complete q8 model is already present in the cache.
# SQLITE_VEC_ALLOW_REMOTE_MODELS=false
# Custom non-Docker installations may bind an audited runtime explicitly.
# SQLITE_VEC_TRANSFORMERS_MODULE=file:///absolute/path/to/transformers.js
# SQLITE_VEC_REQUIRE_TRANSFORMERS=true
